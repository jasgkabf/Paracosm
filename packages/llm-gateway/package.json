{
  "name": "@paracosm/llm-gateway",
  "version": "0.1.0",
  "description": "LLM gateway with smart routing, multiple provider support, custom LLM integration, middleware pipeline, and fallback engine",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@paracosm/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.40",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "typescript": ">=5.5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
