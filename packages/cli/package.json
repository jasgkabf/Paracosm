{
  "name": "@paracosm/cli",
  "version": "0.1.0",
  "description": "CLI for the Paracosm agent project using Ink and Commander.js",
  "bin": {
    "paracosm": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@paracosm/shared": "workspace:*",
    "commander": "^12.1.0",
    "ink": "^4.4.1",
    "react": "^18.3.1",
    "chalk": "^5.3.0",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.40",
    "@types/react": "^18.3.3",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "typescript": ">=5.5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
